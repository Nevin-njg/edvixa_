import { z } from 'zod'

const objectId = z.string().regex(/^[a-f\d]{24}$/i, 'Invalid ID')
const isoDate = z.string().regex(/^\d{4}-\d{2}-\d{2}$/, 'Use YYYY-MM-DD')
const time = z.string().regex(/^([01]\d|2[0-3]):[0-5]\d$/, 'Use HH:mm')
const timezone = z.string().trim().min(2).max(80).default('Asia/Kolkata')

const timeRange = z
  .object({
    startTime: time,
    endTime: time,
  })
  .refine((value) => value.endTime > value.startTime, {
    message: 'End time must be later than start time',
    path: ['endTime'],
  })
  .refine(
    (value) => {
      const [startHour, startMinute] = value.startTime.split(':').map(Number)
      const [endHour, endMinute] = value.endTime.split(':').map(Number)
      const duration =
        ((endHour ?? 0) * 60 + (endMinute ?? 0)) -
        ((startHour ?? 0) * 60 + (startMinute ?? 0))
      return duration >= 30 && duration <= 240
    },
    {
      message: 'Slot duration must be between 30 minutes and 4 hours',
      path: ['endTime'],
    },
  )

const slotBody = z
  .object({
    date: isoDate,
    timezone,
    subjectIds: z.array(objectId).min(1).max(12),
    startTime: time,
    endTime: time,
  })
  .superRefine((value, context) => {
    const result = timeRange.safeParse({
      startTime: value.startTime,
      endTime: value.endTime,
    })
    if (!result.success) {
      for (const issue of result.error.issues) {
        context.addIssue({
          ...issue,
          path: issue.path,
        })
      }
    }
  })

export const availabilityListSchema = z.object({
  query: z.object({
    start: isoDate.optional(),
    end: isoDate.optional(),
  }),
})

export const createAvailabilitySchema = z.object({
  body: slotBody,
})

export const createRecurringAvailabilitySchema = z.object({
  body: z
    .object({
      startDate: isoDate,
      endDate: isoDate,
      weekdays: z.array(z.number().int().min(0).max(6)).min(1).max(7),
      timezone,
      subjectIds: z.array(objectId).min(1).max(12),
      startTime: time,
      endTime: time,
    })
    .superRefine((value, context) => {
      if (value.endDate < value.startDate) {
        context.addIssue({
          code: 'custom',
          path: ['endDate'],
          message: 'End date must not be before start date',
        })
      }
      const days =
        (new Date(`${value.endDate}T00:00:00Z`).getTime() -
          new Date(`${value.startDate}T00:00:00Z`).getTime()) /
        86_400_000
      if (days > 366) {
        context.addIssue({
          code: 'custom',
          path: ['endDate'],
          message: 'Recurring availability cannot exceed one year',
        })
      }

      const result = timeRange.safeParse({
        startTime: value.startTime,
        endTime: value.endTime,
      })
      if (!result.success) {
        for (const issue of result.error.issues) {
          context.addIssue({
            ...issue,
            path: issue.path,
          })
        }
      }
    }),
})

export const updateAvailabilitySchema = z.object({
  params: z.object({ id: objectId }),
  body: slotBody.partial().refine((value) => Object.keys(value).length > 0, {
    message: 'At least one field is required',
  }),
})

export const deleteAvailabilitySchema = z.object({
  params: z.object({ id: objectId }),
})

export const blockAvailabilityDateSchema = z.object({
  body: z.object({
    date: isoDate,
    timezone,
  }),
})

export const copyAvailabilityWeekSchema = z.object({
  body: z.object({
    sourceWeekStart: isoDate,
    targetWeekStart: isoDate,
  }),
})
